# 复制为 worker.env 后填写（worker.env 勿提交 Git）
# cp worker.env.example worker.env

# 服务器 API 根地址（与浏览器访问地址一致，不要带 /app）
AI_PUBLISH_API_BASE=https://your-domain.com

# 系统设置 → 本机发布 Worker → 创建/重置 Token 后粘贴
AI_PUBLISH_WORKER_TOKEN=

# 可选：认领任务长轮询秒数，默认 30
# AI_PUBLISH_WORKER_POLL_TIMEOUT=30

# B 站发布由服务器开关控制，本机 Worker 执行时已信任服务器派发，一般无需设置：
# BILIBILI_ENABLED=true

# 一般无需设置；run-worker.sh 会自动指向项目 vendor/social-auto-upload

# B 站发布需本机预装 biliup（首次执行一次）：
# bash worker/install-biliup-local.sh
# 仅当 vendor 不在默认位置时填写绝对路径：
# SAU_VENDOR_PATH=/path/to/vendor/social-auto-upload
