<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>com.ai-publish.local-worker</string>
  <key>ProgramArguments</key>
  <array>
    <string>__RUN_WORKER_SH__</string>
  </array>
  <key>WorkingDirectory</key>
  <string>__AI_PUBLISH_ROOT__</string>
  <key>RunAtLoad</key>
  <true/>
  <key>KeepAlive</key>
  <true/>
  <key>StandardOutPath</key>
  <string>__AI_PUBLISH_ROOT__/worker/logs/worker.stdout.log</string>
  <key>StandardErrorPath</key>
  <string>__AI_PUBLISH_ROOT__/worker/logs/worker.stderr.log</string>
  <key>ThrottleInterval</key>
  <integer>15</integer>
</dict>
</plist>
