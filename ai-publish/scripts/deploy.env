# 腾讯云 / 生产部署配置（复制为 deploy.env 后修改）
# cp scripts/deploy.env.example scripts/deploy.env
#
# 换服务器 IP 或绑定域名时，一般只需改本文件，然后重新执行 deploy-tencent.sh

# ---------- 访问地址（客户打开的地址）----------
# 无域名：填公网 IP，如 150.158.23.10
# 有域名：填域名，如 publish.example.com（不要带 http://）
PUBLIC_HOST=150.158.23.10

# 是否启用 HTTPS（有域名且已配证书时改为 true）
USE_HTTPS=false

# API 对外端口（防火墙需放行；生产建议 80/443 经 Nginx，此项可保持 8000 仅内网）
API_PORT=8000

# ---------- 安装路径 ----------
INSTALL_DIR=/opt/ai-publish

# Mac 同步代码到服务器时的 SSH 用户（Ubuntu 镜像一般为 ubuntu）
SSH_USER=ubuntu

# ---------- 管理员（首次部署）----------
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-me-in-production

# ---------- 可选：AI Key（也可部署后在管理页配置）----------
DASHSCOPE_API_KEY=
OPENAI_API_KEY=
HUNYUAN_API_KEY=

# ---------- 镜像加速（国内服务器建议保持 true）----------
USE_CN_MIRROR=true
