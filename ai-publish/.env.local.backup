# App
APP_NAME=ai-publish
DEBUG=true
SECRET_KEY=change-me-in-production
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Admin seed user
ADMIN_USERNAME=admin
ADMIN_PASSWORD=admin123

# Database (use sqlite for local dev without Docker)
DATABASE_URL=sqlite:///./data/aipublish.db

# Redis
REDIS_URL=redis://redis:6379/0

# Cookie encryption (32 bytes base64 or any string - will be hashed)
COOKIE_ENCRYPTION_KEY=dev-cookie-key-change-in-prod

# Storage（本地开发用相对路径；Docker 部署见 .env.docker.example）
STORAGE=local
STORAGE_LOCAL_PATH=./data/materials
COOKIE_DIR=./data/cookies

# Adapters
AI_TEXT_PROVIDER=auto
AI_TEXT_MODEL=
AI_IMAGE_PROVIDER=auto
AI_IMAGE_MODEL=
DEFAULT_PLATFORM=xhs

# Aliyun DashScope (通义文案 + 万相文生图)
DASHSCOPE_API_KEY=

# OpenAI 兼容 API
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1

# DeepSeek
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com/v1

# Moonshot (Kimi)
MOONSHOT_API_KEY=
MOONSHOT_BASE_URL=https://api.moonshot.cn/v1

# 本地 Ollama（本机已检测到 qwen3.6:latest 等模型）
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_TEXT_MODEL=

# Playwright
PLAYWRIGHT_HEADLESS=false
PLAYWRIGHT_CHANNEL=chrome
LOGIN_TIMEOUT_SECONDS=120

# Reference project path (for XHS adapter, relative to backend/)
SAU_VENDOR_PATH=../../vendor/social-auto-upload
