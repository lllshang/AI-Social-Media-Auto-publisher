# Docker Compose 部署专用（复制为 .env 后使用）
# cp .env.docker.example .env

APP_NAME=ai-publish
DEBUG=false
SECRET_KEY=change-me-in-production-use-long-random-string
ACCESS_TOKEN_EXPIRE_MINUTES=1440

ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-me-in-production

# 以下由 docker-compose.yml environment 覆盖，此处作说明
DATABASE_URL=mysql+pymysql://aipublish:aipublish123@mysql:3306/aipublish?charset=utf8mb4
REDIS_URL=redis://redis:6379/0
TASK_QUEUE_ENABLED=true
TASK_QUEUE_EMBEDDED_CONSUMER=false

COOKIE_ENCRYPTION_KEY=change-me-cookie-key-in-production

STORAGE=local
STORAGE_LOCAL_PATH=/data/materials
COOKIE_DIR=/data/cookies
# STORAGE=cos 示例（腾讯云 COS S3 兼容）
# OBJECT_STORAGE_ENDPOINT=https://cos.ap-guangzhou.myqcloud.com
# OBJECT_STORAGE_REGION=ap-guangzhou
# OBJECT_STORAGE_BUCKET=your-bucket
# OBJECT_STORAGE_ACCESS_KEY=
# OBJECT_STORAGE_SECRET_KEY=
# OBJECT_STORAGE_PUBLIC_BASE_URL=https://your-bucket.cos.ap-guangzhou.myqcloud.com
# OBJECT_STORAGE_ADDRESSING_STYLE=virtual

NGINX_HTTP_PORT=8080
NGINX_HTTPS_PORT=8443

AI_TEXT_PROVIDER=auto
AI_IMAGE_PROVIDER=auto
DEFAULT_PLATFORM=xhs
REQUIRE_CONTENT_REVIEW=false
SCHEDULER_ENABLED=true
SCHEDULER_POLL_INTERVAL_SECONDS=30

DASHSCOPE_API_KEY=
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com/v1
MOONSHOT_API_KEY=
MOONSHOT_BASE_URL=https://api.moonshot.cn/v1
HUNYUAN_API_KEY=
HUNYUAN_BASE_URL=https://api.hunyuan.cloud.tencent.com/v1
HUNYUAN_IMAGE_BASE_URL=https://api.cloudai.tencent.com/v1
TENCENT_MAAS_API_KEY=
TENCENT_MAAS_BASE_URL=https://tokenhub.tencentmaas.com/v1
ZHIPU_API_KEY=
ZHIPU_BASE_URL=https://open.bigmodel.cn/api/paas/v4
DOUBAO_API_KEY=
DOUBAO_BASE_URL=https://ark.cn-beijing.volces.com/api/v3
BAIDU_API_KEY=
BAIDU_BASE_URL=https://qianfan.baidubce.com/v2
SILICONFLOW_API_KEY=
SILICONFLOW_BASE_URL=https://api.siliconflow.cn/v1
MINIMAX_API_KEY=
MINIMAX_BASE_URL=https://api.minimax.chat/v1

# 容器内访问宿主机 Ollama（Mac/Windows Docker Desktop）
# Linux 服务器见 docs/deployment.md 改用宿主机 IP
OLLAMA_BASE_URL=http://host.docker.internal:11434

# Docker 内无头 Chromium：管理页展示二维码扫码 + 无头自动发布（无需本机 Chrome）
PLAYWRIGHT_HEADLESS=true
PLAYWRIGHT_CHROMIUM_EXECUTABLE=/usr/bin/chromium
LOGIN_TIMEOUT_SECONDS=300
LOGIN_POLL_INTERVAL_SECONDS=1

SAU_VENDOR_PATH=/vendor/social-auto-upload
WEB_DIST_PATH=/web/dist
