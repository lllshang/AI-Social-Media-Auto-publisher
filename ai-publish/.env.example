# App
APP_NAME=ai-publish
DEBUG=true
SECRET_KEY=change-me-in-production
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Admin seed user
ADMIN_USERNAME=admin
ADMIN_PASSWORD=admin123
OPERATOR_USERNAME=operator
OPERATOR_PASSWORD=operator123
VIEWER_USERNAME=viewer
VIEWER_PASSWORD=viewer123

# Database
DATABASE_URL=mysql+pymysql://aipublish:aipublish123@mysql:3306/aipublish?charset=utf8mb4

# Redis
REDIS_URL=redis://redis:6379/0
TASK_QUEUE_ENABLED=true
# Docker 生产环境 API 设为 false，由 worker 服务消费队列
TASK_QUEUE_EMBEDDED_CONSUMER=true

# Cookie encryption (32 bytes base64 or any string - will be hashed)
COOKIE_ENCRYPTION_KEY=dev-cookie-key-change-in-prod

# Storage
# local | stub | cos | oss | s3（后三者走 S3 兼容协议）
STORAGE=local
# 本地开发（./start.sh）用下面两行；Docker 部署改用 .env.docker.example
STORAGE_LOCAL_PATH=./data/materials
COOKIE_DIR=./data/cookies
# 对象存储（STORAGE=cos/oss/s3 时必填）
OBJECT_STORAGE_ENDPOINT=
OBJECT_STORAGE_REGION=
OBJECT_STORAGE_BUCKET=
OBJECT_STORAGE_ACCESS_KEY=
OBJECT_STORAGE_SECRET_KEY=
OBJECT_STORAGE_PUBLIC_BASE_URL=
OBJECT_STORAGE_PREFIX=materials
# virtual（COS 常用）| path（OSS/MinIO 常用）
OBJECT_STORAGE_ADDRESSING_STYLE=virtual

# Adapters
AI_TEXT_PROVIDER=auto
AI_TEXT_MODEL=
AI_IMAGE_PROVIDER=auto
AI_IMAGE_MODEL=
AI_VIDEO_PROVIDER=auto
AI_VIDEO_MODEL=
DEFAULT_PLATFORM=xhs
# 是否启用内容审核（true 时提交进入 pending_review，需 approve 后才可执行）
REQUIRE_CONTENT_REVIEW=false

# B 站视频投稿（实验功能，默认关闭；设为 true 后重启 API，前台才出现 B 站入口）
BILIBILI_ENABLED=false

# AI 视频生成配置（可选）
AI_VIDEO_PROVIDER=auto  # auto | wanxiang_video | minimax_video | hunyuan_video
AI_VIDEO_MODEL=

# 定时发布调度（到点自动执行 pending 且已设置 publish_time 的任务）
SCHEDULER_ENABLED=true
SCHEDULER_POLL_INTERVAL_SECONDS=30

# Aliyun DashScope (通义文案 + 万相文生图 + 万相视频)
DASHSCOPE_API_KEY=

# OpenAI 兼容 API（OpenAI / 各类代理）
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1

# DeepSeek
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com/v1

# Moonshot (Kimi)
MOONSHOT_API_KEY=
MOONSHOT_BASE_URL=https://api.moonshot.cn/v1

# 腾讯混元（OpenAI 兼容接口，密钥见腾讯云混元控制台）
HUNYUAN_API_KEY=
HUNYUAN_BASE_URL=https://api.hunyuan.cloud.tencent.com/v1
HUNYUAN_IMAGE_BASE_URL=https://api.cloudai.tencent.com/v1

# 腾讯 MaaS TokenHub（tokenhub.tencentmaas.com，与混元 OpenAI 接口 Key 不同）
TENCENT_MAAS_API_KEY=
TENCENT_MAAS_BASE_URL=https://tokenhub.tencentmaas.com/v1

# 智谱 AI
ZHIPU_API_KEY=
ZHIPU_BASE_URL=https://open.bigmodel.cn/api/paas/v4

# 字节豆包 (火山方舟)
DOUBAO_API_KEY=
DOUBAO_BASE_URL=https://ark.cn-beijing.volces.com/api/v3

# 百度千帆
BAIDU_API_KEY=
BAIDU_BASE_URL=https://qianfan.baidubce.com/v2

# 硅基流动
SILICONFLOW_API_KEY=
SILICONFLOW_BASE_URL=https://api.siliconflow.cn/v1

# MiniMax（海螺视频：T2V/I2V/S2V-01）
MINIMAX_API_KEY=
MINIMAX_BASE_URL=https://api.minimax.io/v1

# 本地 Ollama
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_TEXT_MODEL=

# Playwright
PLAYWRIGHT_HEADLESS=false
PLAYWRIGHT_CHANNEL=chrome
LOGIN_TIMEOUT_SECONDS=120

# Reference project path (relative to backend/)
SAU_VENDOR_PATH=../../vendor/social-auto-upload
